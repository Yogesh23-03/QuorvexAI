# API gateway — copy to .env. Every value is a placeholder.
#
# The gateway is stateless: it holds no Mongo connection. It uses Redis for
# rate limits and legacy session lookups, and talks to the four services over
# HTTP using the URLs below.

PORT=8000
NODE_ENV=development
SERVICE_NAME=gateway
LOG_LEVEL=info

# ---------------------------------------------------------------- routing ---
# Full URLs of the upstream services. Required in production; the loopback
# defaults only apply while NODE_ENV is not "production".
#
#   ECS with Service Connect:  http://auth:8001
#   ECS with an internal ALB:  http://internal-alb-1234.ap-south-1.elb.amazonaws.com
AUTH_SERVICE=http://localhost:8001
CHAT_SERVICE=http://localhost:8002
AGENT_SERVICE=http://localhost:8003
BILLING_SERVICE=http://localhost:8004

# ---------------------------------------------------------------- browser ---
# Comma-separated list of origins allowed to call the API from a browser.
#
# Same-origin deployments (one CloudFront distribution serving the SPA and
# /api/*) still need this for a non-empty Origin, and it is what protects the
# API if someone points a different site at it. Keep entries unquoted:
#   FRONTEND_URL=https://app.example.com
# localhost origins are always allowed outside production, whatever this says.
FRONTEND_URL=https://app.example.com

# ----------------------------------------------------------------- secrets ---
# Byte-identical to JWT_SECRET in services/auth: the gateway verifies the
# access token the auth service signs. Required in production (the gateway
# refuses to boot without it).
JWT_SECRET=<shared-access-token-secret>

# Shared service-to-service secret. Required in production. The gateway adds
# `x-internal-key` to every proxied request; the services reject direct calls
# without it.
INTERNAL_API_KEY=<internal-api-key>

# ------------------------------------------------------------------- cache ---
# Rate-limit counters and legacy sessions. With no URL (or REDIS_DISABLED) the
# gateway uses an in-process store: fine for one laptop process, wrong for ECS
# (each task would have its own counters).
# Use rediss:// for ElastiCache with in-transit encryption.
REDIS_URL=redis://localhost:6379
# REDIS_DISABLED=false
# REDIS_CONNECT_TIMEOUT_MS=4000
# REDIS_COMMAND_TIMEOUT_MS=4000

# ----------------------------------------------------------------- timeouts ---
# Budget for one proxied request. Keep it below the ALB idle timeout (60s) so
# callers get a JSON 504 from the gateway instead of a dropped connection.
PROXY_TIMEOUT_MS=60000
# Agent runs stream heartbeats, so they get their own (longer) budget.
# AGENT_PROXY_TIMEOUT_MS=210000
# Last-resort budget for non-agent routes before the gateway answers 503.
# REQUEST_TIMEOUT_MS=30000
# Keep-alive must sit above the ALB idle timeout. Defaults shown.
# KEEP_ALIVE_TIMEOUT_MS=65000
# HEADERS_TIMEOUT_MS=66000
