# API gateway — copy to .env. All values are placeholders.
# The gateway is stateless: it uses Redis for rate limits and legacy sessions
# and has no MongoDB connection of its own.

PORT=8000
NODE_ENV=development
SERVICE_NAME=gateway
LOG_LEVEL=info

# Comma-separated allow-list for CORS. Required in production.
FRONTEND_URL=https://app.example.com

# Upstream services. Required in production — the localhost defaults below only
# apply while NODE_ENV is not "production".
AUTH_SERVICE=http://localhost:8001
CHAT_SERVICE=http://localhost:8002
AGENT_SERVICE=http://localhost:8003
BILLING_SERVICE=http://localhost:8004

# Redis: rate limits and legacy session lookups. Without it the gateway falls
# back to an in-process store, which does not survive a restart or scale out.
REDIS_URL=redis://localhost:6379
# REDIS_DISABLED=true

# Shared secret injected into every proxied request. Services reject direct
# calls without it once it is set.
INTERNAL_API_KEY=<internal-api-key>

# Must be byte-identical to JWT_SECRET in services/auth/.env: the gateway
# verifies the access token the auth service signs. Required in production.
JWT_SECRET=<shared-access-token-secret>

# Agent calls can legitimately take minutes; keep the proxy timeout generous.
PROXY_TIMEOUT_MS=180000
