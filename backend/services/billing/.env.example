# Billing service — copy to .env. All values are placeholders.

PORT=8004
NODE_ENV=development
SERVICE_NAME=billing-service
LOG_LEVEL=info

# Owns the payments database. Required.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/quorvex_billing
# Local dev: mongodb://127.0.0.1:27017/quorvex_billing

# Health checks report 503 while Redis is unreachable, so set this everywhere.
REDIS_URL=redis://localhost:6379
# REDIS_DISABLED=true

# The auth service holds the credits; billing calls it to apply a plan change.
AUTH_SERVICE=http://localhost:8001
INTERNAL_API_KEY=<internal-api-key>

# Razorpay. Test-mode keys start with rzp_test_. Payment verification is
# refused when the secret is missing, so a forged signature can never succeed.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=<razorpay-key-secret>
