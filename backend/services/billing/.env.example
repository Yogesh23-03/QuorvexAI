# Billing service — copy to .env. Every value is a placeholder.
#
# Owns the payments collection and talks to Razorpay and to the auth service
# (the only owner of the user document and the credits). Required in
# production: MONGODB_URI, AUTH_SERVICE, INTERNAL_API_KEY, RAZORPAY_KEY_ID,
# RAZORPAY_KEY_SECRET.

PORT=8004
NODE_ENV=development
SERVICE_NAME=billing-service
LOG_LEVEL=info

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/quorvex_billing
# Local dev: mongodb://127.0.0.1:27017/quorvex_billing
# MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
# MONGO_BUFFER_TIMEOUT_MS=5000

# Optional: no route here needs the cache today.
REDIS_URL=redis://localhost:6379
# REDIS_DISABLED=false
# REDIS_CONNECT_TIMEOUT_MS=4000
# REDIS_COMMAND_TIMEOUT_MS=4000

# The auth service applies the plan change; billing never writes user documents.
AUTH_SERVICE=http://localhost:8001
INTERNAL_API_KEY=<internal-api-key>

# Razorpay. Verification is refused when the secret is missing, so a forged
# signature can never succeed. Test keys start with rzp_test_.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=<razorpay-key-secret>

# REQUEST_TIMEOUT_MS=30000
