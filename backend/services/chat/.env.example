# Chat service — copy to .env. All values are placeholders.

PORT=8002
NODE_ENV=development
SERVICE_NAME=chat-service
LOG_LEVEL=info

# Owns the conversations + messages database. Required.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/quorvex_chat
# Local dev: mongodb://127.0.0.1:27017/quorvex_chat

REDIS_URL=redis://localhost:6379
# REDIS_DISABLED=true

INTERNAL_API_KEY=<internal-api-key>
