# Chat service — copy to .env. Every value is a placeholder.
#
# Owns the conversations and messages collections. Required in production:
# MONGODB_URI and INTERNAL_API_KEY (every route is service-to-service only and
# is reached through the gateway, which injects x-user-id).

PORT=8002
NODE_ENV=development
SERVICE_NAME=chat-service
LOG_LEVEL=info

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/quorvex_chat
# Local dev: mongodb://127.0.0.1:27017/quorvex_chat
# MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
# MONGO_BUFFER_TIMEOUT_MS=5000

# Optional: no route here needs the cache today, so an outage is harmless.
REDIS_URL=redis://localhost:6379
# REDIS_DISABLED=false
# REDIS_CONNECT_TIMEOUT_MS=4000
# REDIS_COMMAND_TIMEOUT_MS=4000

INTERNAL_API_KEY=<internal-api-key>

# REQUEST_TIMEOUT_MS=30000
