# Auth service — copy to .env. Every value is a placeholder.
#
# Owns the users collection, the credit ledger and the JWT session. Required in
# production: MONGODB_URI, JWT_SECRET, JWT_REFRESH_SECRET, INTERNAL_API_KEY,
# FRONTEND_URL. Everything else degrades gracefully (see the notes below).

PORT=8001
NODE_ENV=development
SERVICE_NAME=auth-service
LOG_LEVEL=info

# ---------------------------------------------------------------- database ---
# Required. Atlas: add ?authSource=admin when the DB user lives in admin, and
# percent-encode special characters in the password.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/quorvex_auth
# Local dev: mongodb://127.0.0.1:27017/quorvex_auth
# MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
# MONGO_BUFFER_TIMEOUT_MS=5000

# ------------------------------------------------------------------- cache ---
# Refresh-token store and one-shot password-reset tokens. If Redis is
# configured but unreachable, refresh/reset answer 503 quickly instead of
# hanging — do not leave this pointing at a plaintext port when the cluster
# requires TLS (use rediss://).
REDIS_URL=redis://localhost:6379
# REDIS_DISABLED=false
# REDIS_CONNECT_TIMEOUT_MS=4000
# REDIS_COMMAND_TIMEOUT_MS=4000

# ----------------------------------------------------------------- secrets ---
# Required in production: both are HMAC signing keys with no fallback there.
JWT_SECRET=<shared-access-token-secret>
JWT_REFRESH_SECRET=<refresh-token-secret>

# Required in production: the gateway sends it and the service refuses
# service-to-service calls without it.
INTERNAL_API_KEY=<internal-api-key>

# ------------------------------------------------------------------ cookies ---
# Same-origin (SPA and /api on one CloudFront distribution) works with the
# defaults below. COOKIE_DOMAIN is only for sharing cookies across subdomains.
# COOKIE_SECURE=true            # default: true in production, false elsewhere
# COOKIE_SAMESITE=lax           # lax | strict | none (none requires secure)
# COOKIE_DOMAIN=.example.com

# ------------------------------------------------------------------ firebase ---
# Optional: email/password sign-in works without it; Google sign-in does not.
# Give the service account JSON base64-encoded on one line:
#   base64 -w0 serviceAccountKey.json          (Linux)
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json"))
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Alternatively the raw JSON on a single line (containers prefer base64):
FIREBASE_SERVICE_ACCOUNT=

# -------------------------------------------------------------------- links ---
# Used to build password-reset links (and as a CORS allow-list entry).
FRONTEND_URL=https://app.example.com

# --------------------------------------------------------------------- mail ---
# Optional: with SMTP_HOST empty the reset link is written to the log instead
# of being emailed, so local development needs no inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=QuorvexAI <no-reply@example.com>

# ------------------------------------------------------------------ credits ---
# Lazy top-up: every CREDIT_RESET_HOURS the balance is raised to
# CREDIT_RESET_AMOUNT for users below it. Purchased credits are never reduced.
CREDIT_RESET_HOURS=5
CREDIT_RESET_AMOUNT=100

# ----------------------------------------------------------------- timeouts ---
# Per-request budget before the service answers 503 instead of hanging.
# REQUEST_TIMEOUT_MS=30000
