# Auth service — copy to .env. All values are placeholders.

PORT=8001
NODE_ENV=development
SERVICE_NAME=auth-service
LOG_LEVEL=info

# Owns the users database. Required.
# Production (Atlas): mongodb+srv://<user>:<password>@<cluster>/<database>
#   → percent-encode special characters in the password
#   → add ?authSource=admin when the DB user lives in the admin database
#   → allowlist the server IP under Atlas → Network Access
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/quorvex_auth
# Local dev: mongodb://127.0.0.1:27017/quorvex_auth

REDIS_URL=redis://localhost:6379
# REDIS_DISABLED=true

# Shared with the gateway and every service that proxies to it.
INTERNAL_API_KEY=<internal-api-key>

# JWT signing keys: access tokens live 15 minutes, refresh tokens 7 days.
# Both are required — there is no production fallback.
JWT_SECRET=<shared-access-token-secret>
JWT_REFRESH_SECRET=<refresh-token-secret>

# Firebase Admin credentials for Google sign-in, one of:
#   FIREBASE_SERVICE_ACCOUNT        → the JSON on a single line
#   FIREBASE_SERVICE_ACCOUNT_BASE64 → base64 of the JSON (best for containers)
#   serviceAccountKey.json          → local file fallback, git-ignored
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Set when the API is served from a parent domain so the HttpOnly cookies are
# shared behind a load balancer. Leave empty for localhost.
COOKIE_DOMAIN=

# Lazy credit top-up: every CREDIT_RESET_HOURS the balance is restored to
# CREDIT_RESET_AMOUNT for users below it. Purchased credits are never reduced.
CREDIT_RESET_HOURS=5
CREDIT_RESET_AMOUNT=100

# Absolute URL of the frontend, used in password-reset links and CORS.
FRONTEND_URL=https://app.example.com

# Transactional mail. With SMTP_HOST empty the reset message is logged instead
# of sent, so local development needs no inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=QuorvexAI <no-reply@example.com>
