# Agent service — copy to .env. All values are placeholders.

PORT=8003
NODE_ENV=development
SERVICE_NAME=agent-service
LOG_LEVEL=info

# Health/status connection only — the agent service owns no user data.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/quorvex_agent
# Local dev: mongodb://127.0.0.1:27017/quorvex_agent

REDIS_URL=redis://localhost:6379
# REDIS_DISABLED=true

INTERNAL_API_KEY=<internal-api-key>

# Internal services (required in production).
AUTH_SERVICE=http://localhost:8001
CHAT_SERVICE=http://localhost:8002

# LLM providers. At least one key is needed for the matching agents.
OPENROUTER_API_KEY=<openrouter-api-key>
OPENROUTER_MODEL=deepseek/deepseek-chat
GROQ_API_KEY=<groq-api-key>
GROQ_MODEL=openai/gpt-oss-120b
GOOGLE_API_KEY=<google-ai-api-key>
GEMINI_MODEL=gemini-2.0-flash

# Web search and the PDF-RAG vector store.
TAVILY_API_KEY=<tavily-api-key>
QDRANT_URL=https://<cluster>.cloud.qdrant.io
QDRANT_API_KEY=<qdrant-api-key>
EMBEDDING_MODEL=text-embedding-004

# S3 for generated PDF/PPT/image artifacts. Leave the keys empty on AWS to use
# the task or instance role instead of static credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=quorvex-artifacts
SIGNED_URL_TTL_SECONDS=3600

# Where multipart uploads are buffered. Defaults to the OS temp directory.
UPLOAD_DIR=

# Timeouts (ms) — LLM runs can legitimately take minutes.
LLM_TIMEOUT_MS=120000
IMAGE_TIMEOUT_MS=120000
AGENT_TIMEOUT_MS=180000
