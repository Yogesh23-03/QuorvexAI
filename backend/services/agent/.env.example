# Agent service — copy to .env. Every value is a placeholder.
#
# Required in production: MONGODB_URI, INTERNAL_API_KEY, AUTH_SERVICE and
# CHAT_SERVICE. LLM provider keys are only required for the agents that use
# them: chat/search/pdf/ppt use Groq, coding uses OpenRouter, image analysis
# uses Gemini. Without a key, that agent answers 503 PROVIDER_NOT_CONFIGURED.

PORT=8003
NODE_ENV=development
SERVICE_NAME=agent-service
LOG_LEVEL=info

# ---------------------------------------------------------------- database ---
# Not used for user data (the agent service owns none); it backs /health and
# the shared model layer.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/quorvex_agent
# Local dev: mongodb://127.0.0.1:27017/quorvex_agent
# MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
# MONGO_BUFFER_TIMEOUT_MS=5000

# ------------------------------------------------------------------- cache ---
# Short-term conversation memory. A cache outage degrades to "rebuild the
# history from the chat service", never to a failed run.
REDIS_URL=redis://localhost:6379
# REDIS_DISABLED=false
# REDIS_CONNECT_TIMEOUT_MS=4000
# REDIS_COMMAND_TIMEOUT_MS=4000

# ------------------------------------------------------- internal services ---
# Required in production. Full URLs (Service Connect or internal ALB).
AUTH_SERVICE=http://localhost:8001
CHAT_SERVICE=http://localhost:8002
INTERNAL_API_KEY=<internal-api-key>

# ------------------------------------------------------------------ providers ---
OPENROUTER_API_KEY=<openrouter-api-key>
OPENROUTER_MODEL=deepseek/deepseek-chat
GROQ_API_KEY=<groq-api-key>
GROQ_MODEL=openai/gpt-oss-120b
GOOGLE_API_KEY=<google-ai-api-key>
GEMINI_MODEL=gemini-2.5-flash

# Web search and the PDF-RAG vector store (optional per agent).
TAVILY_API_KEY=<tavily-api-key>
QDRANT_URL=https://<cluster>.cloud.qdrant.io
QDRANT_API_KEY=<qdrant-api-key>
EMBEDDING_MODEL=text-embedding-004

# ------------------------------------------------------------------- storage ---
# Generated PDF/PPT/image artifacts. On ECS leave the keys empty and attach an
# IAM task role with S3 access instead of shipping static credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=quorvex-artifacts
SIGNED_URL_TTL_SECONDS=3600

# Multipart uploads are buffered here. Defaults to a temp directory; the image
# sets UPLOAD_DIR=/tmp/quorvex-uploads.
UPLOAD_DIR=

# ------------------------------------------------------------------ timeouts ---
# LLM runs legitimately take minutes. The response head is sent before the run
# and a newline heartbeat every STREAM_HEARTBEAT_MS keeps CloudFront (30s
# origin timeout) and the ALB (60s idle) from closing the connection.
LLM_TIMEOUT_MS=120000
IMAGE_TIMEOUT_MS=120000
AGENT_TIMEOUT_MS=180000
# AGENT_REQUEST_TIMEOUT_MS=210000
# STREAM_HEARTBEAT_MS=15000
# REQUEST_TIMEOUT_MS=30000
