# QuorvexAI frontend — copy to .env and fill in the values.
#
# Everything here is inlined into the bundle at build time, so rebuild after a
# change. Never put a server secret in this file: every VITE_* value is public.

# ------------------------------------------------------------------- API URL ---
# Leave EMPTY for the recommended production setup: one CloudFront distribution
# serves the SPA from S3 and routes /api/* to the ALB, so the app calls its own
# origin (/api/...). Same-origin keeps the httpOnly session cookies
# first-party — no CORS preflight and no SameSite=None.
#
# Set an absolute URL only when the API lives on a different host, e.g.
#   VITE_SERVER_URL=https://api.example.com
# Local development (no .env at all) defaults to http://localhost:8000.
VITE_SERVER_URL=

# ------------------------------------------------------------------ firebase ---
# Firebase Web SDK (Project settings → Your apps → Web app). Optional: without
# these, email/password sign-in still works and Google sign-in is hidden.
VITE_FIREBASE_API_KEY=<firebase-web-api-key>
VITE_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<project-id>
VITE_FIREBASE_STORAGE_BUCKET=<project>.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=<sender-id>
VITE_FIREBASE_APP_ID=<app-id>

# ------------------------------------------------------------------ razorpay ---
# Optional: only needed if the billing service omits keyId from the order.
VITE_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
