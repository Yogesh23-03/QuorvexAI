# QuorvexAI frontend — copy to .env and fill in real values.
# Every value is inlined at build time, so rebuild after changing anything here.
# Never put server secrets in this file: anything VITE_* is public.

# Base URL of the API gateway, no trailing slash. Required.
# Local development: http://localhost:8000
VITE_SERVER_URL=https://api.example.com

# Firebase Web SDK (Project settings → Your apps → Web app).
# Without these, email/password still works and Google sign-in stays hidden.
VITE_FIREBASE_API_KEY=<firebase-web-api-key>
VITE_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<project-id>
VITE_FIREBASE_STORAGE_BUCKET=<project>.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=<sender-id>
VITE_FIREBASE_APP_ID=<app-id>

# Optional: only used when the billing service omits keyId from the order response.
VITE_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
